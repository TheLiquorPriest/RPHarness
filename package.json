{
  "name": "rp-harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "RPH: a harness for roleplay and creative writing on pi's agent loop. A host hands it an environment; it runs a lead agent with tools, sub-agents, sessions, rules and one reply per generation.",
  "license": "MIT",
  "repository": "github:TheLiquorPriest/RPHarness",
  "engines": {
    "bun": ">=1.4"
  },
  "bin": {
    "rph-folder": "./src/hosts/folder/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./helpers": "./src/helpers.ts",
    "./hosts/folder": "./src/hosts/folder/index.ts",
    "./testing/rig": "./src/testing/rig/index.ts",
    "./testing/kit": "./src/testing/kit/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "\"$npm_execpath\" scripts/test-all.ts",
    "test:timings": "\"$npm_execpath\" scripts/test-all.ts --record"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "7.0.2"
  }
}
